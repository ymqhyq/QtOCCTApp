{
  "name": "rcif-web",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "description": "RCIF（铁路构件中性格式）铁路工程数字构件库管理系统 Web 端 (Industrial Titanium)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:determinism": "node scripts/check-determinism.mjs",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node scripts/smoke-api.mjs",
    "e2e": "node scripts/cdp-check.mjs",
    "e2e:extra": "node scripts/cdp-extra.mjs",
    "e2e:viewport": "node scripts/cdp-viewport.mjs",
    "e2e:hidden": "node scripts/cdp-hide.mjs",
    "e2e:features": "node scripts/cdp-features.mjs",
    "e2e:library": "node scripts/cdp-library.mjs",
    "e2e:roles": "node scripts/cdp-roles.mjs",
    "e2e:security": "node scripts/security-smoke.mjs",
    "e2e:family": "node scripts/cdp-family-flow.mjs",
    "e2e:job": "node scripts/cdp-job.mjs",
    "e2e:nonparam": "node scripts/cdp-nonparam.mjs",
    "shots": "node scripts/cdp-shots.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pinia": "^2.2.6",
    "three": "^0.169.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vue-tsc": "^2.1.10"
  }
}
